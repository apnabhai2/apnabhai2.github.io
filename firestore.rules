rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------
    // 1. MASTER ADMIN COLLECTION (Managed by Admin App & Website)
    // ----------------------------------------------------
    match /masterAdmin/{adminId} {
      // Allow direct document lookup (get) for website login by adminId/username
      allow get: if true;

      // STRICTLY PREVENT dumping the entire collection of master admins.
      // Only authenticated users (Admin App) can list all master admins.
      allow list: if request.auth != null;

      // Allow creating or updating a master admin with required schema
      allow create, update: if request.resource.data.username is string
                            && request.resource.data.masterCode is string
                            && (request.resource.data.pass is string || request.resource.data.password is string);

      // Prevent unauthorized deletion of master admin accounts from the web
      allow delete: if request.auth != null;
    }

    // ----------------------------------------------------
    // 2. USERS COLLECTION (Managed by Master Admin Website & Checked by Software)
    // ----------------------------------------------------
    match /users/{userId} {
      // 1. User Software: Lookup license status by userId
      allow get: if true;

      // 2. Website: Master Admin reads and queries users
      allow list: if true;

      // Website: Master Admin creates user with the required software schema
      allow create: if request.resource.data.id is string
                    && request.resource.data.pass is string
                    && request.resource.data.currentDate is timestamp
                    && request.resource.data.expiryDate is timestamp
                    && request.resource.data.masterCode is string;

      // Prevent tampering: user ID and masterCode cannot be modified once created
      allow update: if request.resource.data.id == resource.data.id
                    && request.resource.data.masterCode == resource.data.masterCode;

      // Website: Master Admin deletes users
      allow delete: if true;
    }

    // Deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
