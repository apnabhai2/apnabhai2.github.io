rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 1. MASTER ADMIN COLLECTION (Admin App & Website)
    // =========================================================================
    match /masterAdmin/{adminId} {
      // 1. READ (get & list):
      // - apnaadmin (Admin App): Needs list to stream the admin list
      // - apnamasteradmin (Website): Needs get/list to look up email by username
      // SAFE: Passwords are NEVER stored in Firestore (they are encrypted in Firebase Auth)
      allow read: if true;

      // 2. CREATE:
      // Allow adding a new Master Admin from apnaadmin.
      // Strictly enforces that new accounts have valid username, masterCode, email, uid,
      // and blocks storing passwords in plaintext in Firestore!
      allow create: if request.resource.data.username is string
                    && request.resource.data.masterCode is string
                    && request.resource.data.username.size() >= 3
                    && request.resource.data.masterCode.size() >= 3
                    && (!('email' in request.resource.data) || request.resource.data.email is string)
                    && (!('uid' in request.resource.data) || request.resource.data.uid is string)
                    && !('password' in request.resource.data)
                    && !('pass' in request.resource.data);

      // 3. UPDATE:
      // Allow updates if logged in, or legacy hash upgrade (only pass and isHashed can change)
      allow update: if request.auth != null
                    || (
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pass', 'isHashed'])
                    );

      // 4. DELETE:
      // Warning: Unauthenticated delete is allowed so apnaadmin can remove master admins.
      // For maximum security, sign in on apnaadmin so this can be restricted to request.auth != null.
      allow delete: if true;
    }

    // =========================================================================
    // 2. USERS COLLECTION (Desktop Client Software & Website)
    // =========================================================================
    match /users/{userId} {
      // 1. GET (Direct Document Read):
      // Desktop app & website can read a single user's license document
      allow get: if true;

      // 2. LIST (Queries):
      // - Website: Logged-in Master Admins can list all their users (request.auth != null)
      // - Desktop Client: Queries single user by ID using limit: 2 (request.query.limit <= 5)
      // SECURITY: Prevents hackers from mass-scraping or dumping the entire user database!
      allow list: if request.auth != null || (request.query.limit <= 5);

      // 3. CREATE (HACKER-PROOF):
      // ONLY logged-in Master Admins can create new user licenses!
      // Unauthenticated attackers CANNOT create free accounts or self-register!
      allow create: if request.auth != null
                    && request.resource.data.id is string
                    && request.resource.data.pass is string
                    && request.resource.data.currentDate is timestamp
                    && request.resource.data.expiryDate is timestamp
                    && request.resource.data.masterCode is string
                    && request.resource.data.id.size() > 0;

      // 4. UPDATE (HACKER-PROOF):
      // - Logged-in Master Admin: Can update any field (extend license, stop user, etc.)
      // - Desktop Software (Unauthenticated): CAN ONLY UPDATE 'deviceId' (hardware binding)!
      // HACKER PROOF: No one can tamper with expiryDate, currentDate, stop status, or pass!
      allow update: if request.auth != null
                    || (
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deviceId'])
                    );

      // 5. DELETE (HACKER-PROOF):
      // STRICT SECURITY: Only logged-in Master Admins can delete users.
      // Unauthenticated users/hackers CANNOT delete any customer accounts!
      allow delete: if request.auth != null;
    }

    // Support for capitalized "Users" collection (if referenced by legacy code)
    match /Users/{userId} {
      allow get: if true;
      allow list: if request.auth != null || (request.query.limit <= 5);
      allow create: if request.auth != null
                    && request.resource.data.id is string
                    && request.resource.data.pass is string
                    && request.resource.data.currentDate is timestamp
                    && request.resource.data.expiryDate is timestamp
                    && request.resource.data.id.size() > 0;
      allow update: if request.auth != null
                    || (
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deviceId'])
                    );
      allow delete: if request.auth != null;
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

