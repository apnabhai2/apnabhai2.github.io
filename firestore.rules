rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------
    // 1. MASTER ADMIN COLLECTION (Admin App & Website)
    // ----------------------------------------------------
    match /masterAdmin/{adminId} {
      // Allow single document lookup (get) so website login can find admin's email by username
      allow get: if true;

      // STRICTLY PROTECTED: Only logged-in Master Admins can list all admin accounts
      allow list: if request.auth != null;

      // STRICTLY PROTECTED: Only authenticated admins can create, update, or delete master admins
      allow create, update, delete: if request.auth != null;
    }

    // ----------------------------------------------------
    // 2. USERS COLLECTION (Desktop Software & Website)
    // ----------------------------------------------------
    match /users/{userId} {
      // 1. Desktop software: Lookup license status by specific userId
      allow get: if true;

      // 2. Master Admin Website: Only logged-in Master Admins can list/query users
      // HACKER PROOF: Blocks any unauthorized scraping of users and passwords!
      allow list: if request.auth != null;

      // 3. Master Admin Website: Only logged-in Master Admins can create users
      allow create: if request.auth != null
                    && request.resource.data.id is string
                    && request.resource.data.pass is string
                    && request.resource.data.currentDate is timestamp
                    && request.resource.data.expiryDate is timestamp
                    && request.resource.data.masterCode is string;

      // 4. Updates:
      // - Logged-in Master Admin can update any field (stop, expiryDate, pass, etc.)
      // - Unauthenticated Desktop Software can ONLY update 'deviceId' (cannot hack dates/pass/stop!)
      allow update: if request.auth != null
                    || (
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deviceId'])
                    );

      // 5. Master Admin Website: Only logged-in Master Admins can delete users
      allow delete: if request.auth != null;
    }

    // Deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
